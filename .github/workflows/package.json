{
  "name": "mas-manager",
  "version": "1.0.0",
  "description": "MAS Manager — الماس للخزف والصيني",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.mas.manager",
    "productName": "MAS Manager",
    "files": ["main.js", "preload.js", "icon.ico", "package.json"],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "nsis": { "artifactName": "MAS-Setup.${ext}", "oneClick": true, "perMachine": false }
  }
}
